# Copy to .env and fill in. .env is gitignored — never commit real values.

# Required for Supabase feedback storage. Without these, feedback falls back to
# a local file (reports/feedback.jsonl).
SUPABASE_URL=
SUPABASE_KEY=

# Optional. If unset, the API requires no auth (dev only).
PROMPTGUARD_API_KEY=

# Optional. Registry alias/version or local export dir. Defaults to "champion".
PROMPTGUARD_MODEL=

# Required to reach the shared DagsHub MLflow registry (train.py, eval.py, inference.py).
# Username/password are your DagsHub username and a DagsHub access token (Settings > Tokens).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
