{
  "uid": "promptguard-overview",
  "title": "PromptGuard overview",
  "tags": [
    "promptguard"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select count(*) as value from predictions where $__timeFilter(created_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Injection rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(avg(label::float), 0) as value from predictions where $__timeFilter(created_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select percentile_cont(0.95) within group (order by latency_ms) as value from predictions where $__timeFilter(created_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Proposal target: a few hundred ms on CPU."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Model version in use",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select model_version as value from predictions order by created_at desc limit 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Feedback: wrong predictions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select coalesce(avg((predicted_label <> correct_label)::int::float), 0) as value from feedback where $__timeFilter(created_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Share of user feedback saying the model was wrong."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Latest drift check",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select case when drift_detected then 'DRIFT' when status = 'insufficient_data' then 'NO DATA' else 'OK' end as value from drift_runs order by created_at desc limit 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "DRIFT": {
                  "color": "red",
                  "index": 0
                },
                "OK": {
                  "color": "green",
                  "index": 1
                },
                "NO DATA": {
                  "color": "gray",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^value$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests over time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(created_at, $__interval), count(*) filter (where label = 0) as benign, count(*) filter (where label = 1) as injection from predictions where $__timeFilter(created_at) group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1h"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency p50 / p95",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(created_at, $__interval), percentile_cont(0.5) within group (order by latency_ms) as p50, percentile_cont(0.95) within group (order by latency_ms) as p95 from predictions where $__timeFilter(created_at) group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {},
      "interval": "1h"
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Score distribution",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select to_char(b / 10.0, 'FM990.0') as bucket, n as requests from (select floor(score * 10) as b, count(*) as n from predictions where $__timeFilter(created_at) group by 1) t order by b",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "xField": "bucket",
        "legend": {
          "showLegend": false
        }
      },
      "description": "Bucket = lower edge of a 0.1-wide score band. A shift in this shape is what the drift check looks for."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Prompt length over time (chars)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(created_at, $__interval), avg(text_length) as mean, percentile_cont(0.95) within group (order by text_length) as p95 from predictions where $__timeFilter(created_at) group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {},
      "interval": "1h"
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Feedback per day",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select $__timeGroupAlias(created_at, 1d), count(*) filter (where predicted_label = correct_label) as correct, count(*) filter (where predicted_label <> correct_label) as wrong from feedback where $__timeFilter(created_at) group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Drift score (PSI) per check",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select created_at as time, length_psi as \"length PSI\", score_psi as \"score PSI\" from drift_runs where $__timeFilter(created_at) and status = 'ok' order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 8,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Red line = psi_threshold in ops/config.yaml. A feature only counts as drifted if the KS test agrees too."
    },
    {
      "id": 13,
      "type": "table",
      "title": "Traffic by model version",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "promptguard-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "promptguard-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select model_version, count(*) as requests, round(avg(label::float)::numeric, 3) as injection_rate, round(avg(latency_ms)::numeric, 1) as avg_latency_ms, min(created_at) as first_seen, max(created_at) as last_seen from predictions where $__timeFilter(created_at) group by 1 order by last_seen desc",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}