# Copy to ops/.env.ops  (gitignored). Used by docker compose for variable substitution.

# --- Database that Grafana + Airflow read ---
# LOCAL (fake data):
PG_HOST=postgres
PG_PORT=5432
PG_DB=promptguard
PG_USER=pg
PG_PASSWORD=pg
PG_SSLMODE=disable
# SUPABASE (real): use the "Session pooler" values from Supabase -> Connect, e.g.
# PG_HOST=aws-0-<region>.pooler.supabase.com
# PG_PORT=5432
# PG_DB=postgres
# PG_USER=postgres.<project-ref>
# PG_PASSWORD=<database password>
# PG_SSLMODE=require

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# DagsHub credentials so Airflow can `dvc pull` (create a token in DagsHub -> Settings -> Tokens)
DAGSHUB_USER=
DAGSHUB_TOKEN=

# If the password has special characters ($ # ! & etc.) wrap it in SINGLE quotes: PG_PASSWORD='pa$$w#rd'
# (a password containing a single quote itself: ask for a reset to letters and numbers)
#
# --- For scripts you run on YOUR machine (not in containers): copy the SAME PG_* lines into the repo-root .env ---
# (no URL-encoding needed). DATABASE_URL below is only an alternative.
# Local DB via docker (note port 5433 and host localhost):
# DATABASE_URL=postgresql://pg:pg@localhost:5433/promptguard
# Supabase:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
